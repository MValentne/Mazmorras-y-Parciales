# Puerto del servidor HTTP + WebSockets. En Render lo define el proveedor: no lo setees a mano.
PORT=3001

# Orígenes permitidos por el CORS de Socket.IO, separados por coma.
# Solo hace falta si el frontend se sirve desde un dominio distinto al del servidor.
# Con el deploy de un solo servicio, el origen ya es el mismo: se puede dejar vacío.
WEB_ORIGIN=http://localhost:5173

# URL del backend que se hornea en el bundle de Vite.
# En producción el frontend cae a window.location.origin si no está definida, por eso no hace falta.
# Solo para desarrollo; apps/web/.env.development ya cubre el caso local.
VITE_SERVER_URL=http://localhost:3001
